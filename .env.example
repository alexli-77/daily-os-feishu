# Model provider API keys (BYOK). Set the one matching llm.provider in config.yaml.
# The Docker/Linux shape has no codex/claude CLI, so it requires one of these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Feishu output and feedback target chat.
LARK_APP_ID=
LARK_APP_SECRET=
FEISHU_CHAT_ID=

# Optional owner for Feishu websocket interaction. Use a Feishu/Lark open_id.
FEISHU_OWNER_OPEN_ID=

# Optional GitHub data source.
GITHUB_TOKEN=

# Optional Linear data source.
LINEAR_API_KEY=

# Optional remote vault-gate data source.
VAULT_GATE_URL=
VAULT_GATE_TOKEN=

# Optional Codex override. Configure these in Setup -> Codex when the UI cannot
# find or authenticate the customer's local Codex CLI automatically.
CODEX_BIN=codex
CODEX_HOME=

# Optional Supabase remote for cross-member cycle sync (see supabase/README.md).
# Only ever use the anon key here. The service_role key bypasses RLS and must
# never reach a client.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Only needed to run `npm run verify:supabase`. Two real test users in the same
# team, plus optionally a team the first user does NOT belong to.
SUPABASE_TEST_A_EMAIL=
SUPABASE_TEST_A_PASSWORD=
SUPABASE_TEST_B_EMAIL=
SUPABASE_TEST_B_PASSWORD=
SUPABASE_TEST_OTHER_TEAM_ID=

# Local timezone used by Node and some child processes.
TZ=America/Toronto
